{
  "name": "eagleeye",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "EagleEye - Eagle Flight Control: the interface between the Eagle modules, the D&D 5e system and Foundry VTT. Early release for testing.",
  "scripts": {
    "build:v13": "esbuild v13/module.ts --bundle --format=esm --outfile=v13/dist/module.js",
    "build": "npm run build:v13",
    "typecheck:v13": "tsc -p v13/tsconfig.json",
    "typecheck": "npm run typecheck:v13",
    "test": "vitest run",
    "package": "node v13/package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
