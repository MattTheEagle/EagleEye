{
  "name": "eagleeye",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "EagleEye - Eagle Flight Control: Schnittstelle zwischen den Eagle Modulen, dem DnD-5e-System und Foundry VTT (in Entwicklung).",
  "scripts": {
    "build:v13": "esbuild v13/module.ts --bundle --format=esm --outfile=v13/dist/module.js",
    "build": "npm run build:v13",
    "typecheck:v13": "tsc -p v13/tsconfig.json",
    "typecheck": "npm run typecheck:v13",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
